# Copy to .env.local for development, and add the same keys in your host (e.g. Vercel → Settings → Environment Variables).

# Public site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack → Settings → API Keys & Webhooks (use sk_test_… until you go live). Server-only.
PAYSTACK_SECRET_KEY=

# Masterclass registration fee in Ghana cedis (e.g. 100). Registration stays closed until this is set. 0 = free.
PROGRAMME_FEE_GHS=
# Season label registrations are filed under.
PROGRAMME_SEASON=2027
